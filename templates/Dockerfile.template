FROM python:3.11-slim

WORKDIR /app

# Copy all agent code (including the generated entrypoint.py)
COPY . .

# Upgrade pip, then install the agent's own dependencies when present
RUN pip install --no-cache-dir --upgrade pip \
    && if [ -f requirements.txt ]; then pip install --no-cache-dir -r requirements.txt; fi

# entrypoint.py is generated by Agent Store at build time.
# It reads /app/input/input.json, translates fields, and calls agent.run().
CMD ["python", "entrypoint.py"]
